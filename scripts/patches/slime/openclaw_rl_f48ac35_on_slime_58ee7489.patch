+                if effective_chunk_size <= 1:
+                    raise
+                torch.cuda.empty_cache()
+                effective_chunk_size = max(1, effective_chunk_size // 2)
     else:
         log_prob = logits.new_zeros((0,))
+        entropy = None
         if with_entropy:
             entropy = logits.new_zeros((0,))
 
