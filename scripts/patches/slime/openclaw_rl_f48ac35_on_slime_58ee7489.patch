+_VISION_DIRECT_TO_HF = {
+    "patch_embed.proj.weight": "model.visual.patch_embed.proj.weight",
+    "patch_embed.proj.bias": "model.visual.patch_embed.proj.bias",
+    "pos_embed.weight": "model.visual.pos_embed.weight",
