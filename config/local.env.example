# HarnessTTT site payloads.  Copy to config/local.env and edit; config/env.sh sources it.  Paths only, no credentials.
# Everything listed here lives OUTSIDE the tree (large or site-specific); the tree itself needs no edits to move clusters.
WORKSPACE_ROOT=/path/to/workspace

# frozen executor / proposer base: Qwen/Qwen3.5-9B revision c202236235762e1c871ad0ccb60c8ee5ba337b9a (HF snapshot dir)
# MODELCLOBBER-001 (2026-10-02): keep a base model the job already exported (per-lineage model_path); the 9B is only the default
export SAH_MODEL_PATH="${SAH_MODEL_PATH:-$WORKSPACE_ROOT/model_weights/base/Qwen3.5-9B/c202236235762e1c871ad0ccb60c8ee5ba337b9a}"
# enroot/pyxis image every job runs in (CUDA + docker shim for the AHC evaluators)
export SAH_IMAGE=$WORKSPACE_ROOT/images/<cuda-container>.sqsh
# Python env for the SAH runtime (NexAU + evaluator deps; its bin/python resolves inside the container)
export SAH_RUNTIME_ENV=$WORKSPACE_ROOT/envs/<sah-runtime-py312>
export SAH_PYTHON=$SAH_RUNTIME_ENV/bin/python
# vLLM 0.17.1 env (serves the proposer and the frozen executor; qwen3_xml tool parser)
export VLLM_ENV=$WORKSPACE_ROOT/envs/<vllm-0.17.1-py312>
# training env for slime: torch 2.9.1 + cu128, transformers 5.12.1, flash-linear-attention 0.4.1, ray
export TRAIN_ENV=$WORKSPACE_ROOT/envs/<torch-2.9.1-train-py312>
# external code (scripts/setup/setup_deps.sh clones both into $HARNESSTTT_DEPS when unset)
export NEXAU_ROOT=$WORKSPACE_ROOT/code/NexAU                        # nex-agi/NexAU 09e747b + scripts/patches/nexau/nexau_transport.patch
export MEGATRON_ROOT=$WORKSPACE_ROOT/code/Megatron-LM               # NVIDIA/Megatron-LM core_v0.16.0
# where run dirs, GPU_CAP and generated sbatch files go
export RUN_ROOT=$WORKSPACE_ROOT/runs/HarnessTTT
# pyxis mounts: the tree, the shared storage holding the payloads above, and the GNU time binary the AHC shim expects
export CONTAINER_MOUNTS="$WORKSPACE_ROOT:$WORKSPACE_ROOT,$SAH_AHC_NATIVE_BIN/time:/usr/bin/time"   # the tree and every payload above must be visible inside the container
# Slurm
export HTT_SLURM_ACCOUNT=<your-slurm-account>
export HTT_SLURM_PARTITION=<gpu-partition>
export HTT_SLURM_QOS=<low-priority-qos>
export HARNESSTTT_GPU_CAP=48
export HARNESSTTT_MAX_JOBS=15
# optional: a host Python (with PyYAML) for the login-node steps of chain.sh and for dry runs
# export HARNESSTTT_HOST_PYTHON=python3
