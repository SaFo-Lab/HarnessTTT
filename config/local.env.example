# HarnessTTT site payloads.  Copy to config/local.env and edit; config/env.sh sources it.  Paths only, no credentials.
# Everything listed here lives OUTSIDE the tree (large or site-specific); the tree itself needs no edits to move clusters.
# Every value is written as ${VAR:-default} so a value already exported by the caller (a job, a test) is kept.
WORKSPACE_ROOT="${WORKSPACE_ROOT:-/path/to/workspace}"

# frozen executor / proposer base: Qwen/Qwen3.5-9B revision c202236235762e1c871ad0ccb60c8ee5ba337b9a (HF snapshot dir)
export SAH_MODEL_PATH="${SAH_MODEL_PATH:-$WORKSPACE_ROOT/model_weights/base/Qwen3.5-9B/c202236235762e1c871ad0ccb60c8ee5ba337b9a}"
export SAH_SERVED_MODEL="${SAH_SERVED_MODEL:-qwen3.5-9b}"          # name vLLM serves the model under
# enroot/pyxis image every job runs in (CUDA; the AHC evaluators also need the docker/time shims of the dataset's runtime/ahc_native)
export SAH_IMAGE="${SAH_IMAGE:-$WORKSPACE_ROOT/images/cuda-container.sqsh}"
# Python 3.12 env for the executor runtime (NexAU + evaluator deps; scripts/setup/setup_runtime_env.sh builds it)
export SAH_RUNTIME_ENV="${SAH_RUNTIME_ENV:-$WORKSPACE_ROOT/envs/harnessttt-runtime-py312}"
export SAH_PYTHON="${SAH_PYTHON:-$SAH_RUNTIME_ENV/bin/python}"
# vLLM 0.17.1 env (serves the proposer and the frozen executor; qwen3_xml tool parser)
export VLLM_ENV="${VLLM_ENV:-$WORKSPACE_ROOT/envs/vllm-0.17.1-py312}"
# training env for slime: torch 2.9.1 + cu128, transformers 5.12.1, flash-linear-attention 0.4.1, ray
export TRAIN_ENV="${TRAIN_ENV:-$WORKSPACE_ROOT/envs/torch-2.9.1-train-py312}"
# external code (scripts/setup/setup_deps.sh clones both into $HARNESSTTT_DEPS = HarnessTTT/.deps when these are unset)
# export NEXAU_ROOT="$WORKSPACE_ROOT/code/NexAU"                   # nex-agi/NexAU 09e747b + scripts/patches/nexau/nexau_transport.patch
# export MEGATRON_ROOT="$WORKSPACE_ROOT/code/Megatron-LM"          # NVIDIA/Megatron-LM core_v0.16.0
# where run dirs, GPU_CAP and generated sbatch files go
export RUN_ROOT="${RUN_ROOT:-$WORKSPACE_ROOT/runs/HarnessTTT}"
# pyxis mounts: the tree, the shared storage holding the payloads above (same path inside and outside), and the GNU time
# binary the AHC shim expects.  The tree, the dataset, the model, the envs, RUN_ROOT and .deps must all be under a mount.
export CONTAINER_MOUNTS="${CONTAINER_MOUNTS:-$WORKSPACE_ROOT:$WORKSPACE_ROOT,$SAH_AHC_NATIVE_BIN/time:/usr/bin/time}"
# Slurm
export HTT_SLURM_ACCOUNT="${HTT_SLURM_ACCOUNT:-<your-slurm-account>}"
export HTT_SLURM_PARTITION="${HTT_SLURM_PARTITION:-<gpu-partition>}"
export HTT_SLURM_QOS="${HTT_SLURM_QOS:-<qos>}"                     # set HARNESSTTT_REQUIRE_LOW_QOS=1 to make preflight insist on a *_low QOS
export HARNESSTTT_GPU_CAP="${HARNESSTTT_GPU_CAP:-48}"              # total GPUs of your queued + running jobs the runner may reach
export HARNESSTTT_MAX_JOBS="${HARNESSTTT_MAX_JOBS:-15}"
# optional: a host Python (with PyYAML) for the submitting-host steps of chain.sh and for preflight's import probe
# export HARNESSTTT_HOST_PYTHON=python3
# optional task payloads referenced from dataset/self_adapt_harness/MANIFEST_eft.json (unset = the task falls back to defaults)
# export SAH_KERNEL_EVAL_PYTHON="$WORKSPACE_ROOT/envs/kernel-eval-torch271-py312/bin/python"   # gpu_mode__trimul_lb: torch 2.7.1 / triton 3.3.1 interpreter
# export SAH_NEWTASK_OVERLAY="$WORKSPACE_ROOT/envs/newtask-overlay"                            # astro/bio/zapbench tasks: extra site-packages
